FROM nginx:alpine
COPY catalogo.html /usr/share/nginx/html/index.html
COPY manifest-catalogo.json /usr/share/nginx/html/manifest-catalogo.json
COPY sw-catalogo.js /usr/share/nginx/html/sw.js
COPY icon-192.png /usr/share/nginx/html/icon-192.png
COPY icon-512.png /usr/share/nginx/html/icon-512.png
COPY icon-180.png /usr/share/nginx/html/icon-180.png
EXPOSE 80
